{
  "name": "pdschain-backend",
  "version": "1.0.0",
  "description": "Production-quality backend for PDSChain: Blockchain-Based Public Distribution System with Federated Byzantine Agreement (FBA) consensus.",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "build": "node --check src/server.js && node --check src/app.js",
    "lint": "node --check src/server.js && node --check src/app.js && node --check src/services/transactionService.js && node --check src/controllers/contractController.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --detectOpenHandles --forceExit",
    "migrate": "node src/scripts/runMigrations.js",
    "seed": "node src/seed/seedDatabase.js",
    "healthcheck": "node -e \"fetch('http://127.0.0.1:' + (process.env.PORT || 3000) + '/health/live').then(r => process.exit(r.ok ? 0 : 1)).catch(() => process.exit(1))\"",
    "validators:start": "node src/validators/startValidators.js",
    "provision:admin": "node src/scripts/provisionAdmin.js",
    "provision:identity": "node src/scripts/provisionIdentity.js"
  },
  "keywords": [
    "blockchain",
    "pds",
    "public-distribution-system",
    "fba",
    "consensus",
    "express",
    "sequelize"
  ],
  "author": "PDSChain Team",
  "license": "ISC",
  "dependencies": {
    "@ethereumjs/statemanager": "^10.1.3",
    "@ethereumjs/vm": "^10.1.3",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ethers": "^6.17.0",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.13.1",
    "pg-hstore": "^2.3.4",
    "sequelize": "^6.37.5",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "cross-env": "^7.0.3",
    "jest": "^29.7.0",
    "nodemon": "^3.1.9",
    "supertest": "^7.0.0"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 30000,
    "verbose": true
  }
}
