# ==============================================================================
# PDSChain — Environment Configuration Template (.env.example)
# Copy to .env and replace placeholder values before starting in production.
# ==============================================================================

# Application Runtime
PORT=3000
NODE_ENV=development

# Database Configuration
# Options for DB_DIALECT: sqlite | postgres
# Leave DATABASE_URL blank in development to use SQLite fallback automatically.
# In production with postgres, set DATABASE_URL explicitly:
# Example: DATABASE_URL=postgres://pdschain_user:CHANGE_ME_DB_PASSWORD@localhost:5432/pdschain
DB_DIALECT=sqlite
DATABASE_URL=
DATABASE_STORAGE=../database/pdschain.sqlite

# Audit & Event Journals
EVENTS_JOURNAL_PATH=database/events_journal.jsonl
SECURITY_AUDIT_PATH=database/security_audit.jsonl

# Security & Authentication
# IMPORTANT: In production (NODE_ENV=production), JWT_SECRET MUST be explicitly
# set to a cryptographically random string of at least 32 characters.
JWT_SECRET=<REPLACE_WITH_AT_LEAST_32_CHARACTER_RANDOM_SECRET>
JWT_EXPIRES_IN=24h

# CORS Configuration
# IMPORTANT: In production, wildcard (*) is forbidden. Specify explicit origin(s):
# Example: CORS_ORIGIN=https://pdschain.example.org
CORS_ORIGIN=http://localhost:3000

# Blockchain & Consensus Parameters
BLOCKCHAIN_DIFFICULTY=2
VALIDATOR_COUNT=12

# Validator / Network TLS Configuration (Multi-Process Mode)
VALIDATOR_USE_TLS=false

