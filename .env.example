# ==============================================================================
# PDSChain — Root Environment Configuration Template (.env.example)
# Copy to backend/.env and replace placeholder values before production startup.
# ==============================================================================

# Application Runtime
PORT=3000
NODE_ENV=development

# Database Configuration (sqlite or postgres)
DB_DIALECT=sqlite
DATABASE_URL=
DATABASE_STORAGE=../database/pdschain.sqlite

# Audit & Event Journals
EVENTS_JOURNAL_PATH=database/events_journal.jsonl
SECURITY_AUDIT_PATH=database/security_audit.jsonl

# Security & Authentication (Must be >= 32 chars in production)
JWT_SECRET=<REPLACE_WITH_AT_LEAST_32_CHARACTER_RANDOM_SECRET>
JWT_EXPIRES_IN=24h

# CORS Configuration (Explicit origin required in production; '*' is rejected)
CORS_ORIGIN=http://localhost:3000

# Blockchain & Consensus Parameters
BLOCKCHAIN_DIFFICULTY=2
VALIDATOR_COUNT=12
VALIDATOR_USE_TLS=false

